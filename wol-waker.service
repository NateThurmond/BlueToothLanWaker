[Unit]
Description=WoL Waker — Bluetooth Wake-on-LAN service
Documentation=https://github.com/YOUR_USERNAME/BlueToothLanWaker
After=network-online.target bluetooth.target
Wants=network-online.target bluetooth.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/BlueToothLanWaker
ExecStart=/home/pi/BlueToothLanWaker/venv/bin/python app.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wol-waker

# Allow binding to low ports if ever needed, and keep the service sandboxed
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
